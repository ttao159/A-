# 多智能体 LLM 分析（可选配置）
# 复制本文件为 .env 并填写你自己的大模型 API Key 与接入地址。
# 留空或未配置时，策略生成的多智能体分析会自动降级为启发式结论，不影响使用。
#
# 支持任意 OpenAI 兼容 /chat/completions 接口，例如：
#   OpenAI:      https://api.openai.com/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1

USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini
